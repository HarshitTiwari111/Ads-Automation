PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/google-ads-automation?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here_change_in_production

# Google Ads API
GOOGLE_ADS_CLIENT_ID=your_client_id
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_MANAGER_ACCOUNT_ID=your_mcc_account_id

# Warm-up Campaign Defaults
DEFAULT_DAILY_BUDGET=100
DEFAULT_CAMPAIGN_NAME_PREFIX=Warmup
